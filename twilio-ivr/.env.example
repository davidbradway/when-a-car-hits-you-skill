# Twilio auth token, used to verify that webhook requests really came from
# Twilio. Find it in the Twilio Console (Account Info).
TWILIO_AUTH_TOKEN=

# MUST be "true" in production. It is "false" here because this file is a
# local-development template: without a real Twilio account there is no
# signature to check, and with validation on and no token every request is
# refused with a 500 (a missing token is a misconfiguration, not a reason to
# serve requests unverified).
#
# The code defaults to "true", so a production .env that simply omits this
# line is validated. Do not copy this file to a server.
VALIDATE_TWILIO_SIGNATURE=false

# Where the crash summary report gets emailed.
REPORT_TO_EMAIL=david.bradway@gmail.com
REPORT_FROM_EMAIL=david.bradway@gmail.com

# SMTP credentials used to send the report email. For Gmail, create an App
# Password (Google Account -> Security -> 2-Step Verification -> App
# passwords) and use it as SMTP_PASSWORD — do not use your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seconds to wait on the SMTP server. The report is sent from inside the
# Twilio webhook request and Twilio abandons a webhook after roughly 15
# seconds, so keep this comfortably below that — otherwise a slow mail
# server means the caller never hears the closing guidance.
SMTP_TIMEOUT=10

# When SMTP is not configured the report is normally NOT logged, because it
# contains the caller's phone number, crash location and injury details.
# Set to "true" locally if you want to see the full report in the log.
LOG_REPORT_BODY=false

# Twilio Polly voice for text-to-speech prompts.
TWILIO_VOICE=Polly.Matthew

# Set automatically at image build time (see Dockerfile) and reported by
# /healthz so a deploy can confirm which commit is live. Not needed in a
# local .env.
# GIT_SHA=
