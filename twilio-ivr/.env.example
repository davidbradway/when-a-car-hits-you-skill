# Twilio auth token, used to verify that webhook requests really came from
# Twilio. Find it in the Twilio Console (Account Info).
TWILIO_AUTH_TOKEN=

# Set to "false" to disable signature validation (e.g. quick local testing
# without a real Twilio account). Leave "true" in production.
VALIDATE_TWILIO_SIGNATURE=true

# Where the crash summary report gets emailed.
REPORT_TO_EMAIL=david.bradway@gmail.com
REPORT_FROM_EMAIL=david.bradway@gmail.com

# SMTP credentials used to send the report email. For Gmail, create an App
# Password (Google Account -> Security -> 2-Step Verification -> App
# passwords) and use it as SMTP_PASSWORD — do not use your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Twilio Polly voice for text-to-speech prompts.
TWILIO_VOICE=Polly.Matthew
