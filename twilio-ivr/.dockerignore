# Secrets never enter the image. They come from a .env file on the host at
# runtime, via `docker run --env-file` or compose's env_file.
#
# This is load-bearing, not tidiness: without it a developer's local .env —
# real SMTP password, real Twilio token — would be baked into a published
# image. Verify with:
#   docker run --rm <image> sh -c 'ls -a /app/.env'
.env
.env.*

# Local dev artifacts
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Not needed at runtime. Tests run in CI against the source tree, before the
# image is built — they are not shipped inside it.
tests/
.git/
.gitignore
README.md
Dockerfile
.dockerignore
